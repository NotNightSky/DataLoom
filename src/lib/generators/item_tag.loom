---
id: item_tag
name: Item Tag
version: "26.2"
description: Groups items together under a single tag.
defaultJson: '{ "replace": true, "values": ["minecraft:slime_ball", "minecraft:rotten_flesh", { "id": "#minecraft:dirt", "required": false }, "minecraft:oak_planks", "#minecraft:banners" ] }'
---
// Fabric DataGen Tag
builder(MyTags.CUSTOM_TAG)
{{#each data.values}}
    {{tagEntry this}}
{{/each}}
{{#if data.replace}}
    .setReplace(true)
{{/if}}
    ;