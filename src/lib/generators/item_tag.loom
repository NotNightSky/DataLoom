---
id: item_tag
name: Item Tag
description: Groups items together under a single tag.
defaultJson: '{ "replace": false, "values": ["minecraft:dirt", "minecraft:stone"] }'
---
// Fabric DataGen Tag
getOrCreateTagBuilder(MyTags.CUSTOM_TAG)
{{#each data.values}}
    .add(Identifier.of("{{this}}"))
{{/each}}
    ;